<Window x:Class="VindOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vindOS" Width="420" Height="520" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="14" Background="#FF1E1E1E" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="16" />
        <Image x:Name="Qr" Grid.Row="1" Margin="0,16" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />
        <Button x:Name="PairButton" Grid.Row="2" Content="Pair" Height="44" FontSize="16" Click="Pair_Click" />
        <Expander Grid.Row="3" Header="Settings" Margin="0,12,0,0" Foreground="White">
            <StackPanel Margin="0,8,0,0">
                <TextBlock x:Name="HostText" Margin="0,0,0,8" Opacity="0.7" />
                <Button x:Name="ForgetButton" Content="Forget connection" Height="36" Click="Forget_Click" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
