<Window x:Class="VindOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vindOS" Icon="vindOS.ico" Width="580" Height="680" MinWidth="480" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#F7F8FB" FontFamily="Segoe UI" FontSize="15" Foreground="#17213A">
    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2453E8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D46C7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Foreground" Value="#2453E8" />
            <Setter Property="Background" Value="#E8EDFC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D9E1F9" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#2453E8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8EDFC" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E7F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6478" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid x:Name="Home">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button Content="Settings" Style="{StaticResource Link}" Click="Settings_Click" DockPanel.Dock="Right" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="vindOS.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="vindOS" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="#5B6478" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="Detail" Style="{StaticResource Muted}" TextAlignment="Center" />
                <Image x:Name="Qr" Width="240" Height="240" Margin="0,24,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="SetupCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="NVIDIA CloudXR is needed once" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}">
                        Download <Hyperlink NavigateUri="https://catalog.ngc.nvidia.com/orgs/nvidia/resources/cloudxr-runtime" RequestNavigate="Link_Click">CloudXR Runtime 6.2.3</Hyperlink> and <Hyperlink NavigateUri="https://catalog.ngc.nvidia.com/orgs/nvidia/resources/cloudxr-stream-manager" RequestNavigate="Link_Click">CloudXR Stream Manager 6.1.0</Hyperlink> for Windows from NVIDIA (free account), put both ZIP files in the folder below, then click Check again. vindOS unpacks what it needs.
                    </TextBlock>
                    <TextBlock x:Name="SetupText" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button Content="Open folder" Style="{StaticResource Secondary}" Margin="0,0,6,0" Click="OpenFolder_Click" />
                        <Button Content="Check again" Style="{StaticResource Secondary}" Margin="6,0,0,0" Click="CheckAgain_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border x:Name="SteamCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="SteamTitle" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="SteamText" Style="{StaticResource Muted}" />
                    <Button x:Name="SteamButton" Content="Restart Steam through vindOS" Style="{StaticResource Secondary}" Margin="0,12,0,0" Click="Steam_Click" />
                </StackPanel>
            </Border>
            <Button x:Name="PairButton" Grid.Row="3" Content="Pair" Style="{StaticResource Primary}" Click="Pair_Click" />
        </Grid>
        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button Content="Done" Style="{StaticResource Link}" Click="Settings_Click" DockPanel.Dock="Right" />
                <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vision Pro" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="HostText" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="PairText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            <Button x:Name="ForgetButton" Content="Forget connection" Style="{StaticResource Secondary}" Margin="0,12,0,0" Click="Forget_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VR games" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Found in your Steam library. OpenVR titles need the bridge installed once; originals are kept and can be restored." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <StackPanel x:Name="GamesPanel" Margin="0,0,0,8" />
                            <TextBlock x:Name="GamesText" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <UniformGrid Columns="3">
                                <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource Secondary}" Margin="0,0,6,0" Click="Rescan_Click" />
                                <Button x:Name="BridgeButton" Content="Install bridge" Style="{StaticResource Secondary}" Margin="3,0,3,0" Click="Bridge_Click" />
                                <Button x:Name="UnbridgeButton" Content="Restore" Style="{StaticResource Secondary}" Margin="6,0,0,0" Click="Unbridge_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
